   "source": [
    "def codigos_a_iso3(codigos):\n",
    "    resultado = []\n",
    "    for codigo in codigos:\n",
    "        pais = pycountry.countries.get(numeric=f\"{codigo:03d}\")\n",
    "        if pais is None:\n",
    "            resultado.append(None)\n",
    "        else:\n",
    "            resultado.append(pais.alpha_3)\n",
    "    return resultado"
   ]
  }
